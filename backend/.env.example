# ==============================================================================
# FLASK BACKEND ENVIRONMENT CONFIGURATION (.env)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to version control.
# ==============================================================================

# Server Environment
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000

# Recommended HTTPS Transactional Email API (Resend / Brevo)
# Obtain a free key at https://resend.com or https://brevo.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx

# Fallback SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=arobastin5@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=arobastin5@gmail.com
MAIL_TO=arobastin5@gmail.com

# Allowed CORS Origins
FRONTEND_ORIGIN=https://arobastin.is-my.id,https://arobastin.github.io,http://localhost:3000,http://127.0.0.1:3000
